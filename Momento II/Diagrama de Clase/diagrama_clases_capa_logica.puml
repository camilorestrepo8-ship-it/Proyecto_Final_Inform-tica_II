@startuml diagrama_clases_capa_logica
' =====================================================================
'  Proyecto Final Informática II — Equipo #29
'  "La espada de Bolívar" (South Park) — Diagrama de clases, CAPA LÓGICA
'  (sin clases de interfaz gráfica: esas envolverán a estas en el Momento III)
' =====================================================================
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
left to right direction
skinparam nodesep 40
skinparam ranksep 55
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3A3A3A
  HeaderBackgroundColor #F2F2F2
  StereotypeFontSize 10
}
skinparam class<<Percepcion>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam class<<Razonamiento>> {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
}
skinparam class<<Accion>> {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam class<<Aprendizaje>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam enum {
  BackgroundColor #FAFAFA
}

title Diagrama de clases — Capa lógica\nEquipo #29 · Aventura en el robo de la espada de Bolívar (South Park)

' ------------------------------------------------------------------ NÚCLEO
package "Núcleo" #FAFAFA {
  class Vector2D <<struct>> {
    + x : double
    + y : double
    + operator+(o : const Vector2D&) : Vector2D
    + operator-(o : const Vector2D&) : Vector2D
    + operator*(k : double) : Vector2D
    + magnitud() : double
    + normalizado() : Vector2D
    + distancia(o : const Vector2D&) : double
  }
  class Rectangulo <<struct>> {
    + x, y, ancho, alto : double
    + intersecta(o : const Rectangulo&) : bool
    + contiene(p : const Vector2D&) : bool
  }
  class Temporizador {
    - duracion : double
    - transcurrido : double
    - pausado : bool
    + actualizar(dt : double) : void
    + tiempoRestante() : double
    + haExpirado() : bool
    + reiniciar(nuevaDuracion : double) : void
  }
  class Camara {
    - posicion : Vector2D
    - limites : Rectangulo
    - modo : ModoVista
    - salaActual : std::pair<int,int>
    + seguir(objetivo : const Entidad&) : void
    + cambiarSala(fila : int, col : int) : void
    + aplicarLimites() : void
  }
  enum ModoVista {
    SALA_FIJA
    SCROLL_HORIZONTAL
  }
  class GestorJuego {
    - niveles : std::vector<Nivel*>
    - indiceNivel : int
    - estado : EstadoJuego
    - personajeElegido : TipoPersonaje
    - puntaje : int
    - memoriaGuardias : MemoriaAgente*
    + seleccionarPersonaje(t : TipoPersonaje) : void
    + iniciarNivel(i : int) : void
    + actualizar(dt : double) : void
    + siguienteNivel() : void
    + reiniciarDesdeCheckpoint() : void
  }
  enum EstadoJuego {
    MENU
    SELECCION
    JUGANDO
    PAUSA
    DERROTA
    VICTORIA
  }
  class BusEventos {
    - cola : std::queue<EventoRuido>
    + publicar(e : const EventoRuido&) : void
    + consumirCerca(p : Vector2D, radio : double) : std::vector<EventoRuido>
    + limpiar() : void
  }
  class EventoRuido <<struct>> {
    + origen : Vector2D
    + intensidad : double
    + tipo : TipoRuido
    + instante : double
    + fuente : Entidad*
  }
  enum TipoRuido {
    PASOS
    OBJETO_LANZADO
    VIDRIO_ROTO
    CAIDA
    GRITO
  }
}

' ------------------------------------------------------------------ PERSONAJES
package "Personajes" #FFFDF5 {
  abstract class Entidad {
    # id : int
    # posicion : Vector2D
    # velocidad : Vector2D
    # caja : Rectangulo
    # activo : bool
    + {abstract} actualizar(dt : double) : void
    + colisionaCon(o : const Entidad&) : bool
    + getPosicion() : Vector2D
  }
  abstract class Personaje {
    # vida : int
    # vidaMax : int
    # masa : double
    # velocidadBase : double
    # estado : EstadoAnimacion
    # mirandoDerecha : bool
    # enSuelo : bool
    + mover(dir : Vector2D, dt : double) : void
    + recibirDanio(d : int) : void
    + estaVivo() : bool
  }
  enum EstadoAnimacion {
    IDLE
    CAMINAR
    CORRER
    SALTAR
    TREPAR
    ATACAR
    LANZAR
    HERIDO
    MUERTO
  }
  abstract class Jugador {
    # ruidoBase : double
    # agachado : bool
    # enEscalera : bool
    # inventario : std::map<TipoItem, int>
    # rasgos : std::vector<RasgoPersonalidad*>
    # salto : MovimientoParabolico
    # planeo : CaidaConArrastre
    + lanzarObjeto(dir : Vector2D, fuerza : double) : ProyectilParabolico*
    + emitirRuido() : EventoRuido
    + recoger(item : Item&) : void
    + saltar() : void
    + trepar(dy : double) : void
    + multiplicadorVelocidad() : double
    + {abstract} usarHabilidad() : void
  }
  class Cartman {
    - rabia : double
    + comer(p : Item&) : void
    + hacerBerrinche() : void
    + usarHabilidad() : void
  }
  class Butters {
    - nervios : double
    - temblor : OsciladorAmortiguado
    + ponerseNervioso(distEnemigo : double) : void
    + activarAlterEgo() : void
    + usarHabilidad() : void
  }
  enum TipoPersonaje {
    CARTMAN
    BUTTERS
  }
  abstract class Enemigo {
    # danio : int
    # rangoAtaque : double
    # objetivo : Jugador*
    + {abstract} atacar() : void
  }
  class Policia {
    - agente : AgenteInteligente*
    - rutaPatrulla : std::vector<Vector2D>
    - indiceRuta : int
    - direccionVista : double
    + patrullar(dt : double) : void
    + irHacia(p : Vector2D, dt : double) : void
    + mirarHacia(p : Vector2D) : void
    + capturar() : void
    + atacar() : void
  }
  class Soldado {
    # cadencia : double
    # recarga : Temporizador
    # latasGas : int
    + disparar() : Proyectil*
    + lanzarGas(objetivo : Vector2D) : ProyectilParabolico*
    + atacar() : void
  }
  class Comandante {
    - fase : int
    - refuerzos : Temporizador
    - errorPunteria : double
    + lanzarGranada(objetivo : Vector2D) : ProyectilParabolico*
    + llamarRefuerzos() : std::vector<Soldado*>
    + cambiarFase() : void
    + atacar() : void
  }
}

' ------------------------------------------------------------------ RASGOS
package "Rasgos de personalidad" #FFF8F0 {
  abstract class RasgoPersonalidad {
    # nombre : std::string
    # duracion : Temporizador
    # activo : bool
    + activar(j : Jugador&) : void
    + actualizar(dt : double, j : Jugador&) : void
    + {abstract} aplicar(j : Jugador&) : void
    + {abstract} revertir(j : Jugador&) : void
  }
  class RasgoGloton {
    - bonusFuerza : double = 2.0
    - penalizacionVel : double = 0.7
    - multRuido : double = 1.5
    + aplicar(j : Jugador&) : void
    + revertir(j : Jugador&) : void
  }
  class RasgoBerrinchudo {
    - umbralRabia : double = 100
    - bonusVel : double = 1.25
    - muReducido : double
    + aplicar(j : Jugador&) : void
    + revertir(j : Jugador&) : void
  }
  class RasgoMiedoso {
    - radioPanico : double
    - amplitudTemblor : double
    + aplicar(j : Jugador&) : void
    + revertir(j : Jugador&) : void
  }
  class RasgoAlterEgo {
    - bonusAlcance : double = 1.5
    - tiempoAturdir : double
    + aplicar(j : Jugador&) : void
    + revertir(j : Jugador&) : void
  }
}

' ------------------------------------------------------------------ FÍSICA
package "Física (modelos parametrizables)" #F5FBFF {
  abstract class ModeloFisico {
    # t : double
    # g : double = 9.8
    + {abstract} paso(e : EstadoFisico&, dt : double) : void
    + reiniciar() : void
  }
  class EstadoFisico <<struct>> {
    + pos : Vector2D
    + vel : Vector2D
    + enSuelo : bool
  }
  class MovimientoParabolico {
    - coefRestitucion : double
    + paso(e : EstadoFisico&, dt : double) : void
    + rebotar(e : EstadoFisico&) : void
    + {static} velocidadParaImpacto(o : Vector2D, d : Vector2D, ang : double, g : double) : Vector2D
  }
  class OsciladorAmortiguado {
    # amplitud0 : double
    # gamma : double
    # omega0 : double
    + desplazamiento(t : double) : double
    + omegaAmortiguada() : double
    + perturbar(impulso : double) : void
    + paso(e : EstadoFisico&, dt : double) : void
  }
  class PenduloAmortiguado {
    - longitud : double
    + anguloEn(t : double) : double
    + posicionExtremo(pivote : Vector2D, t : double) : Vector2D
  }
  class MovimientoCircular {
    - centro : Vector2D
    - radio : double
    - omega : double
    - alfa : double
    + anguloEn(t : double) : double
    + acelerar(alfa : double) : void
    + paso(e : EstadoFisico&, dt : double) : void
  }
  class FriccionCinetica {
    - mu : double
    + paso(e : EstadoFisico&, dt : double) : void
  }
  class MasaResorte {
    - k : double
    - b : double
    - masa : double
    - elongacion : double
    - velY : double
    + fuerza() : double
    + velocidadSalida() : double
    + paso(e : EstadoFisico&, dt : double) : void
  }
  class CaidaConArrastre {
    - b : double
    - masa : double
    + velocidadTerminal() : double
    + paso(e : EstadoFisico&, dt : double) : void
  }
}

' ------------------------------------------------------------------ ENTORNO
package "Entorno y objetos" #FBF7FF {
  abstract class ObjetoJuego {
    # interactuable : bool
    + {abstract} alInteractuar(j : Jugador&) : void
  }
  class Proyectil {
    # danio : int
    # duenio : Entidad*
    + alImpactar() : void
  }
  class ProyectilParabolico {
    - fisica : MovimientoParabolico
    - estado : EstadoFisico
    - radioEfecto : double
    - tipo : TipoProyectil
    + alImpactar() : void
    + generarRuido() : EventoRuido
  }
  enum TipoProyectil {
    PIEDRA
    LATA_GAS
    GRANADA
  }
  class Candelabro {
    - pendulo : PenduloAmortiguado
    - radioLuz : double
    + iluminaA(p : Vector2D) : bool
  }
  class Reflector {
    - giro : MovimientoCircular
    - alcance : double
    - apertura : double
    + iluminaA(p : Vector2D) : bool
  }
  class PisoEncerado {
    - friccion : FriccionCinetica
    - zona : Rectangulo
  }
  class Toldo {
    - resorte : MasaResorte
    + impulsar(j : Jugador&) : void
  }
  class Vitrina {
    - resistencia : int
    - rota : bool
    + golpear(fuerza : double) : EventoRuido
  }
  class Item {
    - tipo : TipoItem
    + alInteractuar(j : Jugador&) : void
  }
  enum TipoItem {
    PASABOCAS
    CAPA_ALUMINIO
    PARAGUAS
    LLAVE
    PIEDRA
    ESPADA
  }
  class Escondite {
    - ocupado : bool
    + alInteractuar(j : Jugador&) : void
  }
}

' ------------------------------------------------------------------ NIVELES
package "Niveles" #F7FFF7 {
  abstract class Nivel {
    # numero : int
    # jugador : Jugador*
    # enemigos : std::list<Enemigo*>
    # objetos : std::vector<ObjetoJuego*>
    # proyectiles : std::list<Proyectil*>
    # reloj : Temporizador
    # camara : Camara
    # bus : BusEventos
    + {abstract} inicializar() : void
    + actualizar(dt : double) : void
    + {abstract} verificarVictoria() : bool
    + {abstract} verificarDerrota() : bool
    # resolverColisiones() : void
  }
  class NivelInfiltracion {
    - mapa : MapaCuadricula
    - vitrina : Vitrina*
    - nivelAlerta : int
    - alarma : Temporizador
    - espadaObtenida : bool
    + inicializar() : void
    + verificarCambioSala() : void
    + dispararAlarma() : void
    + verificarVictoria() : bool
    + verificarDerrota() : bool
  }
  class NivelHuida {
    - distanciaRecorrida : double
    - distanciaMeta : double
    - tramos : std::deque<Tramo>
    - frenteSoldados : double
    - comandante : Comandante*
    - capas : std::vector<CapaParallax>
    + inicializar() : void
    + generarTramo() : void
    + actualizarParallax(camX : double) : void
    + verificarVictoria() : bool
    + verificarDerrota() : bool
  }
  class Tramo <<struct>> {
    + inicioX : double
    + plantilla : int
    + colisiones : std::vector<Colision>
    + numToldos : int
    + numSoldados : int
  }
  class CapaParallax <<struct>> {
    + imagen : std::string
    + factor : double
    + desplazamiento : double
  }
  class Colision <<struct>> {
    + caja : Rectangulo
    + tipo : TipoTile
  }
  enum TipoTile {
    VACIO
    SOLIDO
    PLATAFORMA
    ESCALERA
    ENCERADO
    AGUA
  }
  class MapaCuadricula {
    - celdas : std::vector<std::vector<Celda>>
    - tamCelda : int = 40
    + cargar(rutaJson : const std::string&) : void
    + tipoEn(f : int, c : int) : TipoTile
    + esTransitable(f : int, c : int) : bool
    + buscarRuta(o : Vector2D, d : Vector2D) : std::vector<Vector2D>
    + lineaDeVision(a : Vector2D, b : Vector2D) : bool
    + aCelda(p : Vector2D) : std::pair<int,int>
  }
  class Celda <<struct>> {
    + fila : int
    + col : int
    + tipo : TipoTile
    + oscura : bool
  }
}

' ------------------------------------------------------------------ AGENTE
package "Agente inteligente (Policía guardia)" #EEF4FF {
  class AgenteInteligente {
    - cuerpo : Policia*
    - percepcion : ModuloPercepcion
    - razonamiento : ModuloRazonamiento
    - accion : ModuloAccion
    - aprendizaje : ModuloAprendizaje
    - estado : EstadoAgente
    - ultimaDecision : Decision
    + ciclo(j : const Jugador&, bus : BusEventos&, dt : double) : void
    + getEstado() : EstadoAgente
  }
  enum EstadoAgente {
    PATRULLAR
    INVESTIGAR
    PERSEGUIR
    BUSCAR
    ALERTA
    CAPTURA
  }
  class ModuloPercepcion <<Percepcion>> {
    - anguloVision : double
    - alcanceVision : double
    - umbralAuditivo : double
    - mapa : const MapaCuadricula*
    + percibir(j : const Jugador&, bus : BusEventos&, luz : double) : std::vector<Estimulo>
    - verJugador(j : const Jugador&, luz : double) : bool
    - oirRuido(e : const EventoRuido&) : bool
  }
  class Estimulo <<struct>> {
    + tipo : TipoEstimulo
    + posicion : Vector2D
    + intensidad : double
    + confianza : double
    + instante : double
  }
  enum TipoEstimulo {
    VISUAL
    AUDITIVO
    AVISO_COMPANERO
  }
  class ModuloRazonamiento <<Razonamiento>> {
    - sospecha : double
    - umbralInvestigar : double
    - umbralPerseguir : double
    + interpretar(e : const Estimulo&, a : const ModuloAprendizaje&) : Intencion
    + decidir(es : const std::vector<Estimulo>&, a : const ModuloAprendizaje&) : Decision
    - utilidad(t : TipoAccion, e : const Estimulo&) : double
  }
  enum Intencion {
    INTRUSO_CONFIRMADO
    POSIBLE_INTRUSO
    POSIBLE_DISTRACCION
    NADA
  }
  class Decision <<struct>> {
    + accion : TipoAccion
    + destino : Vector2D
    + prioridad : double
    + intencion : Intencion
  }
  enum TipoAccion {
    PATRULLAR
    IR_A
    MIRAR_HACIA
    PERSEGUIR
    BUSCAR_ZONA
    DAR_ALARMA
    CAPTURAR
  }
  class ModuloAccion <<Accion>> {
    - ruta : std::queue<Vector2D>
    - velPatrulla : double
    - velPersecucion : double
    + ejecutar(d : const Decision&, p : Policia&, m : const MapaCuadricula&, dt : double) : ResultadoAccion
    - seguirRuta(p : Policia&, dt : double) : void
  }
  class ResultadoAccion <<struct>> {
    + terminada : bool
    + jugadorEncontrado : bool
    + duracion : double
  }
  class ModuloAprendizaje <<Aprendizaje>> {
    - memoria : MemoriaAgente*
    - eta : double
    - factorOlvido : double
    + registrar(i : const Interaccion&) : void
    + probDistraccion() : double
    + pesoZona(c : std::pair<int,int>) : double
    + siguientePuntoPatrulla(r : const std::vector<Vector2D>&) : Vector2D
    + olvidar(dt : double) : void
  }
  class MemoriaAgente <<compartida>> {
    - mapaCalor : std::map<std::pair<int,int>, double>
    - pDistraccion : double
    - historial : std::deque<Interaccion>
    - ultimaPosJugador : Vector2D
    - {static} MAX_HISTORIAL : const int = 50
  }
  class Interaccion <<struct>> {
    + estimulo : Estimulo
    + decision : Decision
    + resultado : ResultadoAccion
  }
}

' ================================================================== RELACIONES
' --- Herencia propia
Entidad <|-- Personaje
Personaje <|-- Jugador
Jugador <|-- Cartman
Jugador <|-- Butters
Personaje <|-- Enemigo
Enemigo <|-- Policia
Enemigo <|-- Soldado
Soldado <|-- Comandante
Entidad <|-- ObjetoJuego
ObjetoJuego <|-- Proyectil
Proyectil <|-- ProyectilParabolico
ObjetoJuego <|-- Candelabro
ObjetoJuego <|-- Reflector
ObjetoJuego <|-- PisoEncerado
ObjetoJuego <|-- Toldo
ObjetoJuego <|-- Vitrina
ObjetoJuego <|-- Item
ObjetoJuego <|-- Escondite
ModeloFisico <|-- MovimientoParabolico
ModeloFisico <|-- OsciladorAmortiguado
OsciladorAmortiguado <|-- PenduloAmortiguado
ModeloFisico <|-- MovimientoCircular
ModeloFisico <|-- FriccionCinetica
ModeloFisico <|-- MasaResorte
ModeloFisico <|-- CaidaConArrastre
RasgoPersonalidad <|-- RasgoGloton
RasgoPersonalidad <|-- RasgoBerrinchudo
RasgoPersonalidad <|-- RasgoMiedoso
RasgoPersonalidad <|-- RasgoAlterEgo
Nivel <|-- NivelInfiltracion
Nivel <|-- NivelHuida

' --- Composición / agregación
GestorJuego "1" *-- "2..*" Nivel
GestorJuego "1" o-- "1" MemoriaAgente : persiste entre intentos
Nivel "1" *-- "1" Temporizador
Nivel "1" *-- "1" Camara
Nivel "1" *-- "1" BusEventos
Nivel "1" o-- "1" Jugador
Nivel "1" o-- "*" Enemigo
Nivel "1" *-- "*" ObjetoJuego
NivelInfiltracion "1" *-- "1" MapaCuadricula
MapaCuadricula "1" *-- "*" Celda
NivelHuida "1" *-- "*" Tramo
NivelHuida "1" *-- "3..*" CapaParallax
Tramo "1" *-- "*" Colision
Colision --> TipoTile
Celda --> TipoTile
NivelHuida "1" --> "1" Comandante : jefe final
BusEventos "1" o-- "*" EventoRuido
Jugador "1" *-- "2..*" RasgoPersonalidad
Jugador *-- MovimientoParabolico : salto
Jugador *-- CaidaConArrastre : planeo
Butters *-- OsciladorAmortiguado : temblor
Enemigo --> "1" Jugador : objetivo
Candelabro *-- PenduloAmortiguado
Reflector *-- MovimientoCircular
PisoEncerado *-- FriccionCinetica
Toldo *-- MasaResorte
ProyectilParabolico *-- MovimientoParabolico
ProyectilParabolico *-- EstadoFisico
ModeloFisico ..> EstadoFisico : actualiza

' --- Agente inteligente: los 4 módulos por separado
Policia "1" *-- "1" AgenteInteligente
AgenteInteligente "1" *-- "1" ModuloPercepcion : 1. percibir
AgenteInteligente "1" *-- "1" ModuloRazonamiento : 2. razonar
AgenteInteligente "1" *-- "1" ModuloAccion : 3. actuar
AgenteInteligente "1" *-- "1" ModuloAprendizaje : 4. aprender
ModuloPercepcion ..> Estimulo : produce
ModuloPercepcion ..> BusEventos : escucha
ModuloPercepcion --> MapaCuadricula : línea de visión
ModuloRazonamiento ..> Decision : produce
ModuloRazonamiento ..> ModuloAprendizaje : consulta pesos
ModuloAccion ..> ResultadoAccion : produce
ModuloAccion --> MapaCuadricula : buscarRuta()
ModuloAprendizaje "*" o-- "1" MemoriaAgente : compartida por los guardias
MemoriaAgente "1" *-- "0..50" Interaccion
Interaccion *-- Estimulo
Interaccion *-- Decision
Interaccion *-- ResultadoAccion
Estimulo --> TipoEstimulo
Decision --> TipoAccion
Decision --> Intencion
AgenteInteligente --> EstadoAgente

' --- Dependencias de creación
Jugador ..> ProyectilParabolico : <<crea>>
Jugador ..> EventoRuido : <<emite>>
Soldado ..> Proyectil : <<crea>>
Soldado ..> ProyectilParabolico : <<crea>>
Comandante ..> MovimientoParabolico : velocidadParaImpacto()
Vitrina ..> EventoRuido : <<emite>>
ProyectilParabolico ..> EventoRuido : <<emite>>

' --- enums usados
GestorJuego --> EstadoJuego
GestorJuego --> TipoPersonaje
Camara --> ModoVista
Personaje --> EstadoAnimacion
EventoRuido --> TipoRuido
ProyectilParabolico --> TipoProyectil
Item --> TipoItem

legend right
  |= Símbolo |= Significado |
  | <&arrow-thick-top> triángulo vacío | Herencia (propia) |
  | rombo lleno | Composición (el todo crea y destruye la parte) |
  | rombo vacío | Agregación (referencia compartida) |
  | flecha continua | Asociación |
  | flecha punteada | Dependencia (crea / usa / emite) |
  |<#E3F2FD> | Módulo de Percepción |
  |<#EDE7F6> | Módulo de Razonamiento |
  |<#FFF3E0> | Módulo de Acción |
  |<#E8F5E9> | Módulo de Aprendizaje |
endlegend
@enduml
